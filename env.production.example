# OpenAI API 配置
# 如果使用 OpenAI 官方 API，填入 https://api.openai.com/v1
# 如果使用其他兼容 OpenAI 格式的 API（如 Google Gemini），填入對應的 endpoint
OPEN_AI_BASE_URL=https://api.openai.com/v1

# API 金鑰
MODEL_KEY=your_api_key_here

# Next.js 配置
# 生產環境 URL（選填，用於生成 sitemap 等）
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# 禁用遙測（已在 Dockerfile 中設置）
NEXT_TELEMETRY_DISABLED=1
